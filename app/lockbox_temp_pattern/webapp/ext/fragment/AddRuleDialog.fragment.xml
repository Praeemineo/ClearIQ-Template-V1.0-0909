<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Dialog
        id="addRuleDialog"
        title="Add Rule"
        contentWidth="450px">

        <content>
            <l:VerticalLayout class="sapUiContentPadding" width="100%">

                <Label text="Rule ID" labelFor="ruleIdInput" required="true"/>
                <Input
                    id="ruleIdInput"
                    width="100%"
                    placeholder="Pick from the Rules Engine or type manually"
                    showValueHelp="true"
                    valueHelpRequest="onRuleValueHelp"/>

                <Label text="Rule Name" labelFor="ruleNameInput" class="sapUiTinyMarginTop" required="true"/>
                <Input id="ruleNameInput" width="100%" placeholder="e.g. Tolerance Check"/>

            </l:VerticalLayout>
        </content>

        <buttons>
            <Button text="Cancel" press="onCloseCreateRuleDialog"/>
            <Button text="Add" type="Emphasized" press="onConfirmCreateRule"/>
        </buttons>
    </Dialog>

</core:FragmentDefinition>